def buscar(dni,beca):
    con = sqlite3.connect('ejemplo_bdd/db2.db')
    cur = con.cursor()
    q="SELECT * FROM alumnos WHERE nomalum like ? and beca like ?"
    print(q.replace('?',f"'{dni}'",1).replace('?',f"'{beca}'",1))
    cur.execute(q,(dni,beca))
    data = cur.fetchall()
    #print(data)
    con.close()
    return data


buscar('%juan%','si')


