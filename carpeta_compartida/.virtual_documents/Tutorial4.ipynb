def ejecutaOrden(orden,baseDeDatos):
    rows=[]
    con = sqlite3.connect(baseDeDatos)
    with con:    
        cur = con.cursor()    
        cur.execute(orden)
        rows = cur.fetchall()
    con.close()
    return rows


ejecutaOrden('select * from Cars','test.db')


ejecutaOrden("insert into Cars values (2,'Audi',52642)",'test.db')


ejecutaOrden('select * from Cars','test.db')


