def muestraTablaAlumnos():
    con = sqlite3.connect('ejemplo_bdd/db2.db')
    cur = con.cursor()
    q="select * from alumnos"
    cur.execute(q)
    resultado=cur.fetchall()
    con.close()

    print(f"Datos de la tabla Alumnos:\n")
    for x in resultado:
        x=list(x)
        for i,a in enumerate(x):
            if a==None:
                x[i]='---'
        print(f"{x[0]:<10s}{x[1]:<20s}{x[2]:<10s}{x[3]:>20s}{x[4]:>14s}{x[5]:>12s}")


muestraTablaAlumnos()


